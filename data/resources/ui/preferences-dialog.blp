using Gtk 4.0;
using Adw 1;

template $RipsawPreferencesDialog: Adw.PreferencesDialog {
  title: _("Preferences");

  Adw.PreferencesPage {
    Adw.PreferencesGroup {
      title: _("Library");
      description: _("Where ripped files land and which media-server naming scheme is applied.");

      Adw.ActionRow library_root_row {
        title: _("Library root");
        subtitle: _("not configured");
        activatable: true;

        [suffix]
        Image {
          icon-name: "document-edit-symbolic";
          valign: center;
        }
      }

      Adw.ComboRow scheme_combo {
        title: _("Naming scheme");
        subtitle: _("Determines folder layout and ID syntax in filenames.");

        model: StringList {
          strings [
            "Jellyfin",
            "Plex",
            "Kodi",
            "Emby",
          ]
        };
      }
    }

    Adw.PreferencesGroup {
      title: _("Sonarr");
      description: _("Look up canonical series names and episode titles for TV rips.");

      Adw.EntryRow sonarr_url_row {
        title: _("URL");
      }

      Adw.PasswordEntryRow sonarr_key_row {
        title: _("API key");
      }
    }

    Adw.PreferencesGroup {
      title: _("Radarr");
      description: _("Look up canonical movie titles and IDs for movie rips.");

      Adw.EntryRow radarr_url_row {
        title: _("URL");
      }

      Adw.PasswordEntryRow radarr_key_row {
        title: _("API key");
      }
    }
  }
}
