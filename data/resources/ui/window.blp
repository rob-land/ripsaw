using Gtk 4.0;
using Adw 1;

template $ThreeDripWindow: Adw.ApplicationWindow {
  default-width: 960;
  default-height: 640;
  title: _("3drip");

  Adw.ToastOverlay toasts {
    child: Adw.NavigationView nav {
      Adw.NavigationPage {
        title: _("Welcome");

        Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            [start]
            Button {
              action-name: "win.open-disc";
              tooltip-text: _("Scan a disc in an optical drive");

              child: Adw.ButtonContent {
                icon-name: "media-optical-symbolic";
                label: _("Open Disc");
              };
            }

            [start]
            Button {
              action-name: "win.open-iso";
              styles ["suggested-action"]
              tooltip-text: _("Open a disc image (.iso) file");

              child: Adw.ButtonContent {
                icon-name: "document-open-symbolic";
                label: _("Open ISO");
              };
            }

            [end]
            MenuButton {
              primary: true;
              icon-name: "open-menu-symbolic";
              tooltip-text: _("Main Menu");
              menu-model: primary_menu;
            }
          }

          content: Adw.StatusPage {
            icon-name: "media-optical-symbolic";
            title: _("Insert a disc or open an ISO");
            description: _("3drip will scan it, list the titles, and (eventually) rip the ones you pick to your media library.");
          };
        }
      }
    };
  }
}

menu primary_menu {
  section {
    item {
      label: _("Preferences");
      action: "app.preferences";
    }

    item {
      label: _("Keyboard Shortcuts");
      action: "win.show-help-overlay";
    }

    item {
      label: _("About 3drip");
      action: "app.about";
    }
  }
}
