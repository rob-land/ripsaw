using Gtk 4.0;
using Adw 1;

template $ThreeDripTitleListPage: Adw.NavigationPage {
  title: _("Disc Titles");

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [end]
      Button rip_button {
        action-name: "page.rip-selected";
        sensitive: false;
        styles ["suggested-action"]

        child: Adw.ButtonContent {
          icon-name: "document-save-symbolic";
          label: _("Rip Selected");
        };
      }

      Button convert_button {
        action-name: "page.convert-to-fsbs";
        visible: false;
        styles ["suggested-action"]
        tooltip-text: _("Convert this 3D source to full side-by-side");

        child: Adw.ButtonContent {
          icon-name: "view-paged-symbolic";
          label: _("Convert to FSBS");
        };
      }
    }

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup classification_group {
        title: _("Disc type");
        description: _("Auto-detected from title durations. Toggle if it's wrong.");

        Adw.SwitchRow series_toggle {
          title: _("TV series");
          subtitle: _("Each ripped title gets sequential S01E01, S01E02, ...");
        }

        Adw.EntryRow title_override {
          title: _("Series / Movie title");
        }

        Adw.SpinRow season_override {
          title: _("Season number");
          adjustment: Adjustment {
            lower: 0;
            upper: 99;
            step-increment: 1;
            value: 1;
          };
        }
      }

      Adw.PreferencesGroup title_group {
        title: _("Titles found");
        description: _("Tick the titles you want to rip, then press the Rip button.");
      }
    };
  }
}
