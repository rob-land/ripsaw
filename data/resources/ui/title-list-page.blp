using Gtk 4.0;
using Adw 1;

template $RipsawTitleListPage: Adw.NavigationPage {
  title: _("Disc Titles");

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [end]
      Button process_button {
        action-name: "page.process-selected";
        sensitive: false;
        styles ["suggested-action"]

        child: Adw.ButtonContent {
          icon-name: "media-playback-start-symbolic";
          label: _("Process Selected");
        };
      }

      [end]
      Button submit_button {
        action-name: "page.submit-corrections";
        tooltip-text: _("Save corrected title metadata to a staging dir and open TheDiscDB on GitHub");

        child: Adw.ButtonContent {
          icon-name: "send-to-symbolic";
          label: _("Submit to TheDiscDB");
        };
      }
    }

    [top]
    Adw.Banner status_banner {
      revealed: false;
    }

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup identity_group {
        visible: false;

        Box {
          spacing: 16;
          margin-top: 6;
          margin-bottom: 6;

          Picture poster_image {
            width-request: 100;
            height-request: 150;
            content-fit: contain;
            halign: start;
            valign: start;
            overflow: hidden;
            styles ["card"]
          }

          Box {
            orientation: vertical;
            spacing: 4;
            valign: center;
            hexpand: true;

            Label identity_title {
              xalign: 0;
              wrap: true;
              styles ["title-2"]
            }

            Label identity_subtitle {
              xalign: 0;
              wrap: true;
              styles ["dim-label"]
            }
          }
        }
      }

      Adw.PreferencesGroup classification_group {
        title: _("Disc");
        description: _("Auto-detected from title durations. Adjust if it's wrong.");

        Adw.EntryRow title_override {
          title: _("Series / Movie title");

          [suffix]
          Button sonarr_lookup_button {
            valign: center;
            action-name: "page.sonarr-lookup";
            tooltip-text: _("Look up in Sonarr to pre-fill episode titles");
            icon-name: "system-search-symbolic";
          }
        }

        Adw.SwitchRow series_toggle {
          title: _("TV series");
          subtitle: _("Each ripped title gets sequential S01E01, S01E02, ...");
        }

        Adw.SpinRow season_override {
          title: _("Season number");
          visible: false;
          adjustment: Adjustment {
            lower: 0;
            upper: 99;
            step-increment: 1;
            value: 1;
          };
        }
      }

      Adw.PreferencesGroup title_group {
        title: _("Titles found");
        description: _("Tick the titles you want to process, then press the Process button.");
      }

      Adw.PreferencesGroup submission_group {
        title: _("Contribute to TheDiscDB");
        description: _("Optional. Fill in to submit a new entry or corrections to the open disc catalogue.");

        Adw.ExpanderRow submission_expander {
          title: _("Submission metadata");
          subtitle: _("Year, IDs, plot, release details");
          expanded: false;

          Adw.SpinRow year_row {
            title: _("Year");
            adjustment: Adjustment {
              lower: 1900;
              upper: 2100;
              step-increment: 1;
              value: 2025;
            };
          }

          Adw.EntryRow tmdb_id_row {
            title: _("TMDb ID");

            [suffix]
            Button tmdb_lookup_button {
              valign: center;
              action-name: "page.lookup-tmdb";
              tooltip-text: _("Fetch title / year / plot / tagline / IMDb cross-ref from TMDB");
              icon-name: "system-search-symbolic";
            }

            [suffix]
            Button cover_art_button {
              valign: center;
              action-name: "page.pick-cover-art";
              tooltip-text: _("Pick a TMDB poster to ship as cover.jpg with the TheDiscDB submission");
              icon-name: "image-x-generic-symbolic";
            }
          }

          Adw.EntryRow imdb_id_row {
            title: _("IMDb ID (tt…)");

            [suffix]
            Button imdb_lookup_button {
              valign: center;
              action-name: "page.lookup-imdb";
              tooltip-text: _("Look up by IMDb ID via TMDB and fill in the rest");
              icon-name: "system-search-symbolic";
            }
          }

          Adw.EntryRow plot_row {
            title: _("Plot");
          }

          Adw.EntryRow tagline_row {
            title: _("Tagline");
          }

          Adw.EntryRow release_slug_row {
            title: _("Release slug");
          }

          Adw.EntryRow release_title_row {
            title: _("Release title");
          }

          Adw.EntryRow locale_row {
            title: _("Locale (e.g. en-us)");
          }

          Adw.EntryRow region_code_row {
            title: _("Region code (1 / A / B / …)");
          }

          Adw.EntryRow upc_row {
            title: _("UPC / barcode");

            [suffix]
            Button upc_lookup_button {
              valign: center;
              action-name: "page.lookup-upc";
              tooltip-text: _("Look up the UPC on UPCitemDB to fill in ASIN + release title");
              icon-name: "system-search-symbolic";
            }
          }

          Adw.EntryRow asin_row {
            title: _("Amazon ASIN");
          }
        }
      }
    };
  }
}
