using Gtk 4.0;
using Adw 1;

template $RipsawTitleListPage: Adw.NavigationPage {
  title: _("Disc Titles");

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [end]
      Button process_button {
        action-name: "page.process-selected";
        sensitive: false;
        styles ["suggested-action"]

        child: Adw.ButtonContent {
          icon-name: "media-playback-start-symbolic";
          label: _("Process Selected");
        };
      }
    }

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup classification_group {
        title: _("Disc type");
        description: _("Auto-detected from title durations. Toggle if it's wrong.");

        Adw.EntryRow title_override {
          title: _("Series / Movie title");

          [suffix]
          Button sonarr_lookup_button {
            valign: center;
            action-name: "page.sonarr-lookup";
            tooltip-text: _("Look up in Sonarr to pre-fill episode titles");
            icon-name: "system-search-symbolic";
          }
        }

        Adw.SwitchRow series_toggle {
          title: _("TV series");
          subtitle: _("Each ripped title gets sequential S01E01, S01E02, ...");
        }

        Adw.SpinRow season_override {
          title: _("Season number");
          visible: false;
          adjustment: Adjustment {
            lower: 0;
            upper: 99;
            step-increment: 1;
            value: 1;
          };
        }
      }

      Adw.PreferencesGroup output_group {
        title: _("Output");
        description: _("Choose how the selected titles are produced.");
        visible: false;

        Adw.ComboRow output_format_row {
          title: _("3D output format");
          subtitle: _("Pack the dependent view next to the base view in the output MKV.");
          model: StringList {
            strings [
              _("Off — leave the source untouched"),
              _("Full side-by-side (3840×1080)"),
              _("Half side-by-side (1920×1080)"),
              _("Full over/under (1920×2160)"),
              _("Half over/under (1920×1080)"),
              _("Frame-sequential (2× fps)"),
            ]
          };
        }
      }

      Adw.PreferencesGroup title_group {
        title: _("Titles found");
        description: _("Tick the titles you want to process, then press the Process button.");
      }
    };
  }
}
