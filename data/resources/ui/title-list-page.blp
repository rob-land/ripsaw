using Gtk 4.0;
using Adw 1;

template $ThreeDripTitleListPage: Adw.NavigationPage {
  title: _("Disc Titles");

  Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [end]
      Button rip_button {
        action-name: "page.rip-selected";
        sensitive: false;
        styles ["suggested-action"]

        child: Adw.ButtonContent {
          icon-name: "document-save-symbolic";
          label: _("Rip Selected");
        };
      }
    }

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup title_group {
        title: _("Titles found");
        description: _("Tick the titles you want to rip, then press the Rip button.");
      }
    };
  }
}
