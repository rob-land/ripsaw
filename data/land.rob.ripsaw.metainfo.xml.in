<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@app-id@</id>

  <name>Ripsaw</name>
  <summary>Rip DVDs, Blu-rays, and 4K UHD discs with full Jellyfin/Plex naming</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <description>
    <p>
      Ripsaw is a GTK4/libadwaita frontend for MakeMKV that turns a physical
      disc into properly-named files in your media library. It identifies
      discs via TheDiscDB, fills in TMDB/IMDB IDs, lays files out per
      Jellyfin, Plex, Kodi, or Emby conventions, and optionally transcodes
      with quality presets per content type.
    </p>
    <p>Features:</p>
    <ul>
      <li>Auto-identification via TheDiscDB content hash</li>
      <li>Manual entry and submission flow for unknown discs</li>
      <li>Per-title role selection (main feature, trailers, extras)</li>
      <li>Jellyfin / Plex / Kodi / Emby naming schemes</li>
      <li>Optional FFmpeg transcoding with content-type presets</li>
      <li>3D MVC Blu-ray conversion to SBS / TAB / Frame-Sequential</li>
    </ul>
  </description>

  <launchable type="desktop-id">@app-id@.desktop</launchable>

  <url type="homepage">https://git.rob.land/rob/ripsaw</url>
  <url type="bugtracker">https://git.rob.land/rob/ripsaw/issues</url>

  <developer id="land.rob">
    <name>The Ripsaw authors</name>
  </developer>

  <requires>
    <display_length compare="ge">360</display_length>
    <internet>offline-only</internet>
  </requires>

  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>

  <content_rating type="oars-1.1" />

  <releases>
    <release version="0.2.7" date="2026-07-30">
      <description>
        <p>The 3D conversion progress bar now advances. The native decode/encode
        path reports real progress — audio preparation by bytes read, then the
        video encode by ffmpeg's reported time — so a direct-from-ISO 3D rip no
        longer sits at "Starting… 0%".</p>
      </description>
    </release>
    <release version="0.2.6" date="2026-07-30">
      <description>
        <p>Encode with a regular ~2-second keyframe interval instead of the
        encoder's very long default GOP. This makes seeking precise and fixes
        some players showing a black picture at the very start of a file until
        you seek.</p>
      </description>
    </release>
    <release version="0.2.5" date="2026-07-30">
      <description>
        <p>Unencrypted 3D Blu-ray ISOs now decode straight from the image via a
        pure-Rust UDF reader — no loop mount, no MakeMKV rip, and no giant
        intermediate file. This finally makes the fast SSIF path work inside the
        Flatpak sandbox, where the disc mount isn't visible.</p>
      </description>
    </release>
    <release version="0.2.4" date="2026-07-30">
      <description>
        <p>H.265/HEVC is now the default output codec — roughly half the file
        size at the same picture quality, and played by current 3D targets such
        as the Xreal Beam Pro. Pick H.264 in Preferences if you need maximum
        player compatibility.</p>
      </description>
    </release>
    <release version="0.2.3" date="2026-07-30">
      <description>
        <p>Encoding quality is now a simple choice: a Quality preset (Higher /
        Balanced / Smaller) in Preferences that maps to the right settings per
        codec and encoder, so switching to H.265 reliably gives smaller files
        at the same quality. Power users can set an exact CRF/QP via
        conversion_quality_override in config.json.</p>
      </description>
    </release>
    <release version="0.2.2" date="2026-07-30">
      <description>
        <p>Major performance fix: the Flatpak was compiling the native MVC
        decoder in debug mode, making 3D conversion roughly 13× slower than it
        should be. It now builds optimised (release), so decoding a 3D Blu-ray
        to side-by-side runs many times faster.</p>
      </description>
    </release>
    <release version="0.2.1" date="2026-07-30">
      <description>
        <p>Reliability fixes for 3D Blu-ray ripping inside the Flatpak sandbox:
        the keep-MVC MakeMKV profile is now placed where the host MakeMKV can
        read it, so the dependent view is retained (no more silent 2D output).
        The rip log now explains whether the fast SSIF path was taken and why.
        New Preferences option to choose the output codec (H.264 or H.265).</p>
      </description>
    </release>
    <release version="0.2.0" date="2026-07-29">
      <description>
        <p>Working release. Disc identification, MakeMKV-driven ripping,
        Jellyfin/Plex/Kodi naming, and 3D MVC Blu-ray conversion to side-by-side.
        Native, bit-exact MVC decode via libmvc — an unencrypted 3D Blu-ray
        decodes straight from the disc (its SSIF), no makemkvcon rip and no huge
        intermediate file.</p>
      </description>
    </release>
    <release version="0.1.0" date="2026-05-28">
      <description>
        <p>Initial design sketch. No functionality yet.</p>
      </description>
    </release>
  </releases>
</component>
