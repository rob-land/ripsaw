[Desktop Entry]
Name=Ripsaw
GenericName=Disc Ripper
Comment=Rip DVDs, Blu-rays, and 4K UHD discs to your media library
Categories=AudioVideo;Video;
Icon=@app-id@
Exec=ripsaw %U
Terminal=false
Type=Application
StartupNotify=true
Keywords=disc;dvd;bluray;uhd;makemkv;jellyfin;plex;ripper;
MimeType=x-content/video-dvd;x-content/video-bluray;
X-GNOME-UsesNotifications=true
