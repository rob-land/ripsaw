{
  "_comment": "MakeMKV is not bundled — invoked on the host via flatpak-spawn --host. See docs/architecture.md § Sandboxing & Flatpak. cargo fetches crates (incl. the libmvc git dep) during the build, so the ripsaw module builds with --share=network (fine for a personal repo; Flathub would require vendored cargo-sources).",

  "id": "land.rob.ripsaw",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable",
    "org.freedesktop.Sdk.Extension.llvm20"
  ],
  "command": "ripsaw",

  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--device=all",
    "--filesystem=xdg-videos",
    "--filesystem=xdg-music",
    "--filesystem=xdg-pictures",
    "--filesystem=/run/media:ro",
    "--talk-name=org.freedesktop.Flatpak",
    "--talk-name=org.freedesktop.secrets",
    "--talk-name=org.freedesktop.UDisks2.*",
    "--system-talk-name=org.freedesktop.UDisks2"
  ],

  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm20/bin",
    "build-args": ["--share=network"],
    "env": {
      "CARGO_HOME": "/run/build/ripsaw/cargo"
    }
  },

  "modules": [
    {
      "name": "ripsaw",
      "buildsystem": "meson",
      "config-opts": ["--buildtype=release"],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [".git", "build", "target", ".flatpak-builder", ".github"]
        }
      ]
    }
  ]
}
