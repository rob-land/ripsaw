{
  "_comment": "Stub Flatpak manifest. MakeMKV is not bundled — invoked on the host via flatpak-spawn --host. See docs/architecture.md § Sandboxing & Flatpak.",

  "id": "dev.threedrip.ThreeDrip",
  "runtime": "org.gnome.Platform",
  "runtime-version": "47",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable",
    "org.freedesktop.Sdk.Extension.llvm18"
  ],
  "command": "threedrip",

  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--device=all",
    "--filesystem=xdg-videos",
    "--filesystem=xdg-music",
    "--filesystem=xdg-pictures",
    "--talk-name=org.freedesktop.Flatpak",
    "--talk-name=org.freedesktop.secrets",
    "--talk-name=org.freedesktop.UDisks2.*",
    "--system-talk-name=org.freedesktop.UDisks2"
  ],

  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/threedrip/cargo"
    }
  },

  "modules": [
    {
      "name": "blueprint-compiler",
      "buildsystem": "meson",
      "cleanup": ["*"],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/jwestman/blueprint-compiler.git",
          "tag": "v0.12.0"
        }
      ]
    },
    {
      "name": "threedrip",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "dir",
          "path": "../.."
        }
      ]
    }
  ]
}
